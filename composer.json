{
  "name": "fapost/connector-slack",
  "description": "A FaPost channel connector for Slack: an assistant answers in a Slack workspace through a Slack app",
  "type": "fapost-connector",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fapost-lab/connector-slack",
  "support": {
    "issues": "https://github.com/fapost-lab/connector-slack/issues",
    "source": "https://github.com/fapost-lab/connector-slack"
  },
  "require": {
    "php": "^8.4",
    "fapost/foundation": ">=0.33 <1.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Fapost\\Connector\\Slack\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fapost\\Connector\\Slack\\Tests\\": "tests/"
    }
  },
  "extra": {
    "fapost": {
      "schema": 1,
      "id": "slack",
      "name": "Slack",
      "description": "Answers in a Slack workspace through a Slack app: text, Block Kit buttons and media by link.",
      "provider": "Fapost\\Connector\\Slack\\SlackConnectorServiceProvider",
      "channels": ["slack"]
    }
  },
  "minimum-stability": "stable"
}
